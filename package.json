{
	"name": "combo-tracker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "concurrently -n api,vite -c blue,green \"tsx scripts/dev-api.ts\" \"vite\"",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "tsx --test tests/planner.test.ts tests/plannerState.test.ts tests/pathFinder.test.ts",
		"test:exporter": "node --test tests/export-planner.test.mjs",
		"test:browser": "node tests/browser-check.mjs",
		"test:server-parity": "node ../../../node_modules/vitest/vitest.mjs run --config ../../../vitest.config.ts tests/server-parity.test.ts",
		"data:export": "node scripts/export-planner.mjs",
		"data:check": "node scripts/export-planner.mjs --check",
		"test:unlock": "node scripts/test-unlock.mjs"
	},
	"dependencies": {
		"curl": "^0.1.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"redis": "^5.12.1"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.1",
		"@vercel/node": "^4.0.0",
		"@vitejs/plugin-react": "^4.3.1",
		"concurrently": "^9.0.0",
		"express": "^4.21.0",
		"tsx": "^4.19.0",
		"typescript": "^5.5.3",
		"vite": "^5.4.0"
	}
}
